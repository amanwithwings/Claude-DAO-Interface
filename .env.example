# Free Arbiscan API key — get one at https://arbiscan.io/register (no payment needed)
# Used for fetching historical proposals (> 40 days old) via Arbiscan's log API.
# Without this key the app still works but is rate-limited to 1 req/5s.
VITE_ARBISCAN_API_KEY=

# Optional: custom Arbitrum One RPC URL for recent proposal fetching and contract reads.
# Recommended: use a free Alchemy key from https://alchemy.com for best reliability.
# Without this, the app falls back to window.ethereum (MetaMask) and public free nodes.
VITE_RPC_URL=
